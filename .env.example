# Kopieren nach ".env" und ausfüllen:  cp .env.example .env

# Passwort für die Anmeldung auf der Lernplattform
APP_PASSWORD=hier-das-passwort-eintragen

# Zufälliger, langer Schlüssel für die Anmelde-Cookies.
# Erzeugen mit:  openssl rand -hex 32
SESSION_SECRET=

# Name oben links auf der Seite
SITE_TITLE=Tim’s Feuerwehr Lernplattform

# Auf "true" setzen, sobald die Seite nur noch über https erreichbar ist (z. B. Cloudflare Tunnel)
COOKIE_SECURE=false

# Nur für Cloudflare Tunnel (siehe ANLEITUNG.md, Schritt 5)
TUNNEL_TOKEN=
